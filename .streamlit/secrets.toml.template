# .streamlit/secrets.toml.template
#
# ── HOW TO USE ────────────────────────────────────────────────────────────────
# 1. Copy this file:   cp .streamlit/secrets.toml.template .streamlit/secrets.toml
# 2. Fill in your values below.
# 3. secrets.toml is gitignored — never commit it.
#
# For Streamlit Cloud:
#   App settings → Secrets → paste the key=value pairs directly into the UI.
#   You do NOT upload this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── API connection ────────────────────────────────────────────────────────────
# Leave blank to run the model in-process (local dev, no server needed).
# Set to your Cloud Run URL to connect the dashboard to the live API.
API_BASE_URL = ""
# Example: API_BASE_URL = "https://sa-credit-stress-monitor-xxxx-oa.a.run.app"

# ── Live data keys ────────────────────────────────────────────────────────────
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
# Only needed if you want the dashboard to pull live VIX / USD index data.
FRED_API_KEY = ""
